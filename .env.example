# Copy to .env to override the defaults. Every value is optional.

# Host ports
API_PORT=8080
POSTGRES_PORT=55432
KAFKA_PORT=59094
# Observability profile
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
KAFKA_UI_PORT=8090

# Logging: debug | info | warn | error, json | text
LOG_LEVEL=info
LOG_FORMAT=json

# Rates provider: frankfurter (the real API) | fake (works without internet)
RATES_PROVIDER=frankfurter
# Fake provider only: latency, and the share of calls that fail (0..1),
# to watch retries and the failed status in a demo
FAKE_RATES_DELAY=500ms
FAKE_RATES_FAILURE_RATE=0
