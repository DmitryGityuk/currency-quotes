# Store and check out text files with LF line endings on every OS.
# Without this, Git on Windows converts LF to CRLF, and shell scripts
# or configs mounted into Linux containers break with "bad interpreter".
* text=auto eol=lf

*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
