# Settings of the public demo (compose.server.yaml). Copy to .env in the
# project root on the server: cp deploy/server.env.example .env

# Makes every docker compose command use the server setup on top of the base.
COMPOSE_FILE=compose.yaml:compose.server.yaml

# Address of the demo. Without a domain of your own, sslip.io maps a name to
# the IP written in it: quotes.203-0-113-7.sslip.io resolves to 203.0.113.7.
DOMAIN=

# PostgreSQL password, letters and digits only (it goes into a URL):
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Grafana admin password; visitors do not need it, the dashboard is open
# read-only at https://grafana.DOMAIN: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=

# frankfurter (the real API) or fake
RATES_PROVIDER=frankfurter
